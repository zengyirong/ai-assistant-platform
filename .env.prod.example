# AI Assistant Platform — production env example
# Copy to repo root as .env.prod and replace all placeholders.
# Do not commit .env.prod.

APP_ENV=prod
DEBUG=false
APP_SECRET=REPLACE_WITH_32PLUS_RANDOM_CHARS

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=ai_assistant
MYSQL_USER=aap
MYSQL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_STRONGER_ROOT_PASSWORD

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks

# fake = offline smoke; openai_compatible = real RAG
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=REPLACE_WITH_LLM_KEY
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=openai_compatible

EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=REPLACE_WITH_EMBEDDING_KEY
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BATCH_SIZE=10

RAG_TOP_K=5
RAG_REFUSE_MESSAGE=当前知识库中未找到可靠依据。

FILE_STORAGE_PATH=/app/data/files
MAX_UPLOAD_SIZE_MB=20

ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Must match the public HTTPS origin (JSON array string)
CORS_ORIGINS=["https://aap.example.com"]
