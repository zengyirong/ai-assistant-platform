FROM node:22-slim AS builder

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
# 4G 服务器构建易 OOM；2C4G 默认应在本地/大机器构建后上传镜像
ENV NODE_OPTIONS=--max-old-space-size=2048
ENV TZ=Asia/Shanghai
ENV CI=true

WORKDIR /app

RUN corepack enable

COPY . /app

# 生产 API 走同源反代，避免打到 mock 域名
RUN printf '%s\n' \
  'VITE_BASE=/' \
  'VITE_GLOB_API_URL=/api/v1' \
  'VITE_COMPRESS=none' \
  'VITE_PWA=false' \
  'VITE_ROUTER_HISTORY=hash' \
  'VITE_INJECT_APP_LOADING=true' \
  'VITE_ARCHIVER=false' \
  > apps/web-ele/.env.production

RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile
RUN pnpm run build:ele

FROM nginx:stable-alpine AS production

RUN rm -f /etc/nginx/conf.d/default.conf

COPY --from=builder /app/apps/web-ele/dist /usr/share/nginx/html
COPY scripts/deploy/nginx.prod.conf /etc/nginx/nginx.conf

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
