# AI Assistant Platform — local env example
# Copy to repo root as .env (do not commit secrets)

APP_ENV=dev
APP_SECRET=change-me-in-local-dev

# Host MySQL (local install). Fill MYSQL_PASSWORD with your real password.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ai_assistant
MYSQL_USER=root
MYSQL_PASSWORD=REPLACE_WITH_YOUR_MYSQL_PASSWORD

QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

FILE_STORAGE_PATH=./data/files
MAX_UPLOAD_SIZE_MB=20
