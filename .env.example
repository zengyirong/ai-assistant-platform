# AI Assistant Platform — local env example
# Copy to repo root as .env (do not commit secrets)

APP_ENV=dev
APP_SECRET=change-me-in-local-dev

# Host MySQL (local install). Fill MYSQL_PASSWORD with your real password.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ai_assistant
MYSQL_USER=root
MYSQL_PASSWORD=REPLACE_WITH_YOUR_MYSQL_PASSWORD

QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# fake = 本地伪流式；openai_compatible = 真实 Chat Completions
LLM_PROVIDER=fake

EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
# fake = 本地确定性向量（无外网也可跑通流水线）；openai_compatible = 调真实 Embedding API
EMBEDDING_PROVIDER=fake
# 阿里云 text-embedding-v3/v4 单次最多 10 条；OpenAI 可更大
EMBEDDING_BATCH_SIZE=10

RAG_TOP_K=5
# RAG_SCORE_THRESHOLD=
# RAG_REFUSE_MESSAGE=当前知识库中未找到可靠依据。

FILE_STORAGE_PATH=./data/files
MAX_UPLOAD_SIZE_MB=20
